{
  "name": "prodify-orchestrator",
  "version": "1.0.0",
  "description": "Root orchestrator for Prodify (Tauri + FastAPI)",
  "scripts": {
    "dev:backend": "cd backend && .\\venv\\Scripts\\uvicorn main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run tauri dev",
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
